{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zecpath Job Description Schema",
  "description": "Standard structure for storing job requirements and responsibilities.",
  "type": "object",
  "required": [
    "job_id",
    "job_title",
    "department",
    "job_type",
    "experience_required",
    "education_requirements",
    "required_skills",
    "preferred_skills",
    "responsibilities",
    "certifications"
  ],
  "properties": {
    "job_id": {
      "type": "string"
    },
    "job_title": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "job_type": {
      "type": "string",
      "enum": [
        "Technical",
        "Non-Technical"
      ]
    },
    "experience_required": {
      "type": "object",
      "required": [
        "minimum_years",
        "maximum_years"
      ],
      "properties": {
        "minimum_years": {
          "type": "number",
          "minimum": 0
        },
        "maximum_years": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "education_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skill"
      }
    },
    "preferred_skills": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/skill"
      }
    },
    "responsibilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "skill": {
      "type": "object",
      "required": [
        "name",
        "category"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "category": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}